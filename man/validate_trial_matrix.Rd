\name{validate_trial_matrix}
\alias{validate_trial_matrix}
\title{Validate the dimensions of an experimental yield grid}
\description{Checks the numeric matrix before modeling.}
\usage{
validate_trial_matrix(trial)
}
\arguments{
\item{trial}{Numeric rows-by-columns yield matrix.}
}
\value{A one-row data frame with dimensions, number of basic units, and range.}
