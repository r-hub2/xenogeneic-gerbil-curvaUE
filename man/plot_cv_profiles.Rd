\name{plot_cv_profiles}
\alias{plot_cv_profiles}
\title{Plot empirical CV profiles}
\description{Shows CV against width and length with the power-law curves.}
\usage{
plot_cv_profiles(configurations, surface)
}
\arguments{
\item{configurations}{Output of plot_configurations().}
\item{surface}{Output of fit_cv_surface().}
}
\value{A ggplot object.}
