\name{max_gaussian_curvature}
\alias{max_gaussian_curvature}
\title{Maximum Gaussian curvature solution}
\description{Closed-form maximum of Gaussian curvature for the separable power-law surface.}
\usage{
max_gaussian_curvature(a, m, n)
}
\arguments{
\item{a,m,n}{Positive power-law surface parameters.}
}
\value{A one-row data frame with continuous dimensions, area, predicted CV, and K.}
