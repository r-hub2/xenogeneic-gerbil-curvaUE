\name{as_long_trial_data}
\alias{as_long_trial_data}
\title{Convert a spatial grid into long-format observations}
\description{Adds row and column indices without changing spatial cell positions.}
\usage{
as_long_trial_data(trial)
}
\arguments{
\item{trial}{Numeric yield matrix.}
}
\value{A data frame with row, column, and yield.}
