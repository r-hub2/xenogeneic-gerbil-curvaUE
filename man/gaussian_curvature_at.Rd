\name{gaussian_curvature_at}
\alias{gaussian_curvature_at}
\title{Gaussian curvature at a point}
\description{Calculates Gaussian curvature of z=a*x^(-m)*y^(-n).}
\usage{
gaussian_curvature_at(a, m, n, x, y)
}
\arguments{
\item{a,m,n}{Positive power-law surface parameters.}
\item{x,y}{Positive basic-unit coordinates.}
}
\value{A numeric Gaussian-curvature value.}
